# Copy to srcs/.env and replace EVERY placeholder before the first build.
# These values are written into the database at the first boot and cannot be
# changed by editing this file afterwards. See DEV_DOC.md, "Environment file".
# No password belongs here: those go in secrets/.

# The domain the site answers on. Must match the nginx server_name and your
# /etc/hosts entry.
DOMAIN_NAME=login.42.fr

# MariaDB
MYSQL_DATABASE=wordpress
MYSQL_USER=your_db_user

# WordPress site
WP_TITLE=Inception

# WordPress admin
WP_ADMIN_USER=your_admin_name
WP_ADMIN_EMAIL=admin@example.com

# WordPress second user
WP_USER=your_second_user
WP_USER_EMAIL=user@example.com

# FTP user
FTP_USER=nobody
